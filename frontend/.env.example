# Base URL of the backend API (without trailing slash / or /api suffix)
# For local development: http://localhost:5001
# For production deployment: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001
# Vite fallback (if running Vite):
VITE_API_URL=http://localhost:5001

# Supabase Project Configuration & OpenID Endpoints
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_SUPABASE_AUTH_AUTHORIZE_URL="https://your-project-id.supabase.co/auth/v1/oauth/authorize"
NEXT_PUBLIC_SUPABASE_AUTH_TOKEN_URL="https://your-project-id.supabase.co/auth/v1/oauth/token"
NEXT_PUBLIC_SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"
NEXT_PUBLIC_SUPABASE_OPENID_CONFIGURATION_URL="https://your-project-id.supabase.co/auth/v1/.well-known/openid-configuration"
NEXT_PUBLIC_SUPABASE_AUTH_CALLBACK_URL="https://your-project-id.supabase.co/auth/v1/callback"

# Google OAuth Credentials (Get from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Live Game Verification API
VNGZZ2GAME_API_KEY="your-provider-api-key"
VNGZZ2GAME_API_URL="https://www.vngzz2game.site/api/v1/game"
VNGZZ2GAME_GAME2_URL="https://www.vngzz2game.site/api/v1/game2"
